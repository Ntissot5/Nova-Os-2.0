{
  "$description": "Source unique du système de design Nova OS. Lecture humaine : DESIGN-SYSTEM.md. Généré vers CSS par design/build.mjs.",
  "space": {
    "0-5": { "$type": "dimension", "$value": "4px" },
    "1": { "$type": "dimension", "$value": "8px" },
    "2": { "$type": "dimension", "$value": "16px" },
    "3": { "$type": "dimension", "$value": "24px" },
    "4": { "$type": "dimension", "$value": "32px" },
    "6": { "$type": "dimension", "$value": "48px" },
    "8": { "$type": "dimension", "$value": "64px" }
  },
  "measure": { "$type": "dimension", "$value": "720px" },
  "font": {
    "family": { "$type": "fontFamily", "$value": "\"Inter Variable\", Inter, system-ui, sans-serif" },
    "display": { "size": { "$value": "40px" }, "line": { "$value": "48px" }, "weight": { "$value": 600 } },
    "title": { "size": { "$value": "22px" }, "line": { "$value": "32px" }, "weight": { "$value": 600 } },
    "body": { "size": { "$value": "17px" }, "line": { "$value": "24px" }, "weight": { "$value": 400 } },
    "body-strong": { "size": { "$value": "17px" }, "line": { "$value": "24px" }, "weight": { "$value": 600 } },
    "caption": { "size": { "$value": "13px" }, "line": { "$value": "16px" }, "weight": { "$value": 500 } }
  },
  "radius": { "$type": "dimension", "$value": "12px" },
  "radius-full": { "$type": "dimension", "$value": "999px" },
  "shadow": {
    "1": { "$type": "shadow", "$value": "0 1px 2px rgb(0 0 0 / .06), 0 4px 12px rgb(0 0 0 / .06)" },
    "2": { "$type": "shadow", "$value": "0 8px 32px rgb(0 0 0 / .12)" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "base": { "$type": "duration", "$value": "200ms" },
    "ease": { "$type": "cubicBezier", "$value": "cubic-bezier(.2, 0, 0, 1)" }
  },
  "color": {
    "light": {
      "bg": { "$value": "#FFFFFF" },
      "surface": { "$value": "#F5F5F7" },
      "text": { "$value": "#1D1D1F" },
      "text-muted": { "$value": "#6E6E73" },
      "positive": { "$value": "#1A7F37" },
      "attention": { "$value": "#B35900" },
      "critical": { "$value": "#C62828" }
    },
    "dark": {
      "bg": { "$value": "#111113" },
      "surface": { "$value": "#1C1C1F" },
      "text": { "$value": "#F5F5F7" },
      "text-muted": { "$value": "#A1A1A6" },
      "positive": { "$value": "#3FB950" },
      "attention": { "$value": "#F0883E" },
      "critical": { "$value": "#FF6B6B" }
    }
  }
}
